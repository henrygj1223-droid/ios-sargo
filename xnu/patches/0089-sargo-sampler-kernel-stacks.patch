--- a/bsd/dev/sargo_sdhci.c
+++ b/bsd/dev/sargo_sdhci.c
@@ -41,6 +41,7 @@
 #include <pexpert/pexpert.h>
 #include <pexpert/device_tree.h>
 #include <libkern/libkern.h>
+#include <libkern/OSAtomic.h>
 
 /* osfmk/arm/machine_routines.h, not exported to the BSD layer */
 extern vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
@@ -1337,6 +1338,58 @@
 sargo_sdhci_close(__unused dev_t dev, __unused int flags, __unused int devtype, __unused struct proc *p)
 {
 	return 0;
+}
+
+/*
+ * Diagnostics for the process sampler (patch 0089): one line per sample with
+ * the request counters, the read mode, and whether a request is inside the
+ * driver right now (and for how long) or waiting for the lock. Early boots
+ * froze with one process blocked for minutes (seputil, mount_hfs, mount);
+ * this says whether the driver is involved.
+ */
+static volatile uint64_t sargo_io_start;        /* mach time the current request got the lock; 0 = idle */
+static volatile uint64_t sargo_io_lba;          /* its partition-relative sector */
+static volatile uint32_t sargo_io_count;        /* its byte count */
+static volatile bool sargo_io_write;
+static volatile int32_t sargo_io_waiters;       /* requests waiting for sargo_sdhci_lock */
+static uint64_t sargo_io_done, sargo_io_errors;
+void sargo_sdhci_dump(void);
+
+void
+sargo_sdhci_dump(void)
+{
+	uint64_t start = sargo_io_start, ms = 0;
+
+	if (start != 0) {
+		absolutetime_to_nanoseconds(mach_absolute_time() - start, &ms);
+		ms /= 1000000;
+	}
+	printf("SMP sdhci: %llu req %llu err, mb %d fast %d %u-bit mberr %u, ov %llu MB, %d waiting; %s lba 0x%llx %u B %llu ms\n",
+	    sargo_io_done, sargo_io_errors, sargo_mb_on, sargo_fast, sargo_bus_width, sargo_mb_errors,
+	    sargo_ov_bytes >> 20, sargo_io_waiters,
+	    start == 0 ? "idle" : (sargo_io_write ? "IN WRITE" : "IN READ"),
+	    sargo_io_lba, sargo_io_count, ms);
+}
+
+static void
+sargo_io_enter(uint64_t off, uint32_t count, bool is_write)
+{
+	uint64_t now = mach_absolute_time();
+
+	sargo_io_lba = off / SDHCI_BLOCK;
+	sargo_io_count = count;
+	sargo_io_write = is_write;
+	sargo_io_start = now ? now : 1;
+}
+
+static void
+sargo_io_leave(int error)
+{
+	sargo_io_start = 0;
+	sargo_io_done++;
+	if (error) {
+		sargo_io_errors++;
+	}
 }
 
