+			uint32_t want = MIN(count - done, SDHCI_BLOCK - skip);
+			uint32_t s = (uint32_t)(lba % SARGO_OV_SECTORS);
+			struct sargo_ov_ent *e = sargo_ov_get(lba / SARGO_OV_SECTORS);
+			uint8_t *sec;
+
+			if (e == NULL) {
+				error = ENOSPC;
