+/*
+ * sargo_rw=1: write count bytes at partition byte offset off from src to the
+ * eMMC. Whole sectors go out up to 128 KiB per command; a partial sector is
+ * read first and merged. A failure in fast mode drops to 1-bit 25 MHz and
+ * retries once. Lock held.
+ */
+static int
+sargo_write_range(uint64_t off, uint32_t count, const uint8_t *src)
+{
+	uint32_t done = 0;
+
+	while (done < count) {
+		uint64_t pos = off + done;
+		uint64_t lba = pos / SDHCI_BLOCK;
+		uint32_t skip = (uint32_t)(pos % SDHCI_BLOCK);
+		uint32_t left = count - done;
+		uint32_t n, got;
+		int error;
+
+		if (skip != 0 || left < SDHCI_BLOCK) {
+			error = sdhci_read_block(ss.first_block + lba);
+			if (error) {
+				return error;
+			}
+			got = MIN(left, SDHCI_BLOCK - skip);
+			memcpy(sargo_mb_buf, (const uint8_t *)ss.bounce, SDHCI_BLOCK);
+			memcpy(sargo_mb_buf + skip, src + done, got);
+			n = 1;
+		} else {
+			n = sargo_mb_on ? MIN(left / SDHCI_BLOCK, SARGO_MB_MAX_BLOCKS) : 1;
+			got = n * SDHCI_BLOCK;
+			memcpy(sargo_mb_buf, src + done, got);
+		}
+		error = sdhci_write_multi(ss.first_block + lba, n);
+		if (error && sargo_fast) {
+			printf("SARGO SDHCI: write error in fast mode; back to 1-bit 25 MHz\n");
+			sargo_set_safe_mode();
+			error = sdhci_write_multi(ss.first_block + lba, n);
+		}
+		if (error) {
+			return error;
+		}
 		done += got;
 	}
 	return 0;
