+				/* Partial sector: start from the eMMC contents. */
+				error = sdhci_read_block(ss.first_block + lba);
+				if (error) {
+					break;
+				}
+				memcpy(sec, (const uint8_t *)ss.bounce, SDHCI_BLOCK);
+			}
+			memcpy(sec + skip, vaddr + done, want);
+			e->valid |= (uint8_t)(1u << s);
+			done += want;
+			buf_setresid(bp, count - done);
+		}
+		lck_mtx_unlock(&sargo_sdhci_lock);
+		buf_unmap(bp);
+		goto done;
+	}
 	for (uint32_t done = 0; done < count;) {
 		uint64_t pos = off + done;
 		uint64_t lba = pos / SDHCI_BLOCK;
 		uint32_t skip = (uint32_t)(pos % SDHCI_BLOCK);
 		uint32_t want = MIN(count - done, SDHCI_BLOCK - skip);
-		error = sdhci_read_block(ss.first_block + lba);
-		if (error) {
-			break;
+		const uint8_t *ov = sargo_ov_sector(lba);
+		if (ov != NULL) {
+			memcpy(vaddr + done, ov + skip, want);
+		} else {
+			error = sdhci_read_block(ss.first_block + lba);
+			if (error) {
+				break;
+			}
+			memcpy(vaddr + done, (const uint8_t *)ss.bounce + skip, want);
 		}
-		memcpy(vaddr + done, (const uint8_t *)ss.bounce + skip, want);
 		done += want;
 		buf_setresid(bp, count - done);
 	}
@@ -955,10 +1087,10 @@
 }
 
