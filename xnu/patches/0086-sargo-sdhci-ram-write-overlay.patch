sargo SDHCI: keep writes in a RAM overlay instead of dropping them

Patch 0082 absorbed every write without storing it. HFS later re-read
blocks it had written after its buffer cache evicted them and got the old
userdata contents: first boot of the 20H392 root panicked ~36 min in with
"hfs_UNswap_BTNode: invalid forward link (0xFBF40026)" (pid 194
itunescloudd). Writes now go to an in-memory overlay of 4 KiB pages
(sector-granular valid bits) and reads prefer it. The eMMC is still never
written; changes are lost at reboot. Cap: sargo_ovmb=<MiB>, default 256.
Raw-device writes take the same path through physio.

--- a/bsd/dev/sargo_sdhci.c
+++ b/bsd/dev/sargo_sdhci.c
@@ -32,6 +32,7 @@
 #include <sys/uio.h>
 #include <miscfs/devfs/devfs.h>
 #include <kern/locks.h>
+#include <kern/kalloc.h>
 #include <kern/clock.h>
 #include <machine/machine_routines.h>
 #include <arm/caches_internal.h>
@@ -150,6 +151,105 @@
 static LCK_GRP_DECLARE(sargo_sdhci_grp, "sargo_sdhci");
 static LCK_MTX_DECLARE(sargo_sdhci_lock, &sargo_sdhci_grp);
 
+/*
+ * RAM write overlay. The driver cannot write the eMMC yet, and absorbing
+ * writes made HFS read back stale blocks after its buffer cache evicted
+ * them (2026-11-10 boot: "hfs_UNswap_BTNode: invalid forward link" in
+ * itunescloudd ~36 min in - a catalog node it had written came back as the
+ * old, never-flashed contents of userdata). Every write now lands here, in
+ * 4 KiB pages keyed by partition-relative page index, and reads prefer it.
+ * Nothing is written to the eMMC; changes last until the next boot.
+ * Size cap: sargo_ovmb=<MiB> (default SARGO_OV_DEFAULT_MB).
+ * All overlay state is protected by sargo_sdhci_lock.
+ */
+#define SARGO_OV_PAGE           4096u
+#define SARGO_OV_SECTORS        (SARGO_OV_PAGE / SDHCI_BLOCK)
+#define SARGO_OV_BUCKETS        (1u << 16)
+#define SARGO_OV_DEFAULT_MB     256u
+
+struct sargo_ov_ent {
+	struct sargo_ov_ent *next;
+	uint64_t page;                  /* partition-relative 4 KiB page index */
+	uint8_t *data;                  /* SARGO_OV_PAGE bytes */
+	uint8_t valid;                  /* bit n: sector n holds written data */
+};
+
+static struct sargo_ov_ent *sargo_ov_hash[SARGO_OV_BUCKETS];
+static uint64_t sargo_ov_bytes;         /* page data held */
+static uint64_t sargo_ov_limit;         /* cap on sargo_ov_bytes */
+static bool sargo_ov_full_logged;
+
+static inline uint32_t
+sargo_ov_bucket(uint64_t page)
+{
+	return (uint32_t)((page * 0x9E3779B97F4A7C15ull) >> 48) & (SARGO_OV_BUCKETS - 1);
+}
+
+static struct sargo_ov_ent *
+sargo_ov_find(uint64_t page)
+{
+	struct sargo_ov_ent *e;
+	for (e = sargo_ov_hash[sargo_ov_bucket(page)]; e != NULL; e = e->next) {
+		if (e->page == page) {
+			return e;
+		}
+	}
+	return NULL;
+}
+
+/* Find or create the overlay page; NULL when the cap or memory runs out. */
+static struct sargo_ov_ent *
+sargo_ov_get(uint64_t page)
+{
+	struct sargo_ov_ent *e = sargo_ov_find(page);
+	uint32_t b;
+
+	if (e != NULL) {
+		return e;
+	}
+	if (sargo_ov_bytes + SARGO_OV_PAGE > sargo_ov_limit) {
+		if (!sargo_ov_full_logged) {
+			sargo_ov_full_logged = true;
+			printf("SARGO SDHCI: RAM write overlay full (%llu MB, sargo_ovmb); writes now fail\n",
+			    sargo_ov_limit >> 20);
+		}
+		return NULL;
+	}
+	e = kalloc_type(struct sargo_ov_ent, Z_WAITOK | Z_ZERO);
+	if (e == NULL) {
+		return NULL;
+	}
+	e->data = kalloc_data(SARGO_OV_PAGE, Z_WAITOK | Z_ZERO);
+	if (e->data == NULL) {
+		kfree_type(struct sargo_ov_ent, e);
+		return NULL;
+	}
+	e->page = page;
+	b = sargo_ov_bucket(page);
+	e->next = sargo_ov_hash[b];
+	sargo_ov_hash[b] = e;
+	sargo_ov_bytes += SARGO_OV_PAGE;
+	if ((sargo_ov_bytes >> 20) != ((sargo_ov_bytes - SARGO_OV_PAGE) >> 20) &&
+	    ((sargo_ov_bytes >> 20) % 5) == 0) {
+		printf("SARGO SDHCI: %llu MB of writes held in RAM (not saved to eMMC)\n",
+		    sargo_ov_bytes >> 20);
+	}
+	return e;
+}
+
+/* Overlay copy of partition-relative sector lba, or NULL to read the eMMC. */
+static const uint8_t *
+sargo_ov_sector(uint64_t lba)
+{
+	struct sargo_ov_ent *e = sargo_ov_find(lba / SARGO_OV_SECTORS);
+	uint32_t s = (uint32_t)(lba % SARGO_OV_SECTORS);
+
+	if (e == NULL || !(e->valid & (1u << s))) {
+		return NULL;
+	}
+	return e->data + s * SDHCI_BLOCK;
+}
+
 static inline uint8_t
 sdhci_rd8(uint32_t off)
 {
@@ -825,20 +925,10 @@
