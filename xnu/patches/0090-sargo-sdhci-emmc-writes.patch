+/*
+ * Real eMMC writes (patch 0090, boot-arg sargo_rw=1). Data goes from
+ * sargo_mb_buf to the card with CMD24 (one block) or CMD25 + Auto CMD12,
+ * through the same page-wise ADMA2 table as sdhci_read_multi(). The call
+ * returns only after the card has left its programming busy state and
+ * CMD13 reports no error, so a completed buf is on the flash (the cache is
+ * switched off at init): HFS journal ordering holds across power loss.
+ */
+#define SARGO_WR_BUSY_NS        (3ull * NSEC_PER_SEC)   /* programming busy limit */
+#define R1_ERROR_BITS           0xe4380000u             /* R1 errors Linux checks for data commands */
+#define R1_CURRENT_STATE(r)     (((r) >> 9) & 0xfu)
+#define R1_STATE_TRAN           4u
+#define EXT_CSD_CACHE_CTRL      33
+
+static bool sargo_rw;                   /* sargo_rw=1: writes go to the eMMC */
+static uint64_t sargo_wr_bytes;
+
+/* Wait (up to SARGO_WR_BUSY_NS) for DAT0 high and the card back in TRAN with no error bits. */
+static int
+sargo_wait_programmed(void)
+{
+	uint64_t deadline;
+	uint32_t resp[4];
+	int error;
+
+	nanoseconds_to_absolutetime(SARGO_WR_BUSY_NS, &deadline);
+	deadline += mach_absolute_time();
+	for (;;) {
+		if (sdhci_rd32(REG_PRESENT_STATE) & PRES_DAT0) {
+			error = sdhci_cmd(13, (uint32_t)ss.rca << 16,
+			    CMD_RESP_SHORT | CMD_FLAG_CRC | CMD_FLAG_INDEX, 0, resp);
+			if (error) {
+				return error;
+			}
+			if (resp[0] & R1_ERROR_BITS) {
+				printf("SARGO SDHCI: write: card status 0x%08x\n", resp[0]);
+				return EIO;
+			}
+			if (R1_CURRENT_STATE(resp[0]) == R1_STATE_TRAN) {
+				return 0;
+			}
+		}
+		if (mach_absolute_time() > deadline) {
+			printf("SARGO SDHCI: write: card still programming after 3 s (pres 0x%08x)\n",
+			    sdhci_rd32(REG_PRESENT_STATE));
+			return ETIMEDOUT;
+		}
+		delay(50);
+	}
+}
+
+/* Write n (1..SARGO_MB_MAX_BLOCKS) blocks from sargo_mb_buf to device lba. */
+static int
+sdhci_write_multi(uint64_t lba, uint32_t n)
+{
+	uint64_t deadline, desc_phys;
+	uint32_t bytes = n * SDHCI_BLOCK;
+	uint32_t nd = (bytes + SARGO_MB_CHUNK - 1) / SARGO_MB_CHUNK;
+	uint16_t nint = 0, eint = 0;
+	uint8_t idx = (n == 1) ? 24 : 25;
+	int error = 0;
+
+	if (n == 0 || n > SARGO_MB_MAX_BLOCKS || lba + n - 1 > UINT32_MAX) {
+		return EINVAL;
+	}
+	ss.data_fail = NULL;
+
+	nanoseconds_to_absolutetime(CMD_TIMEOUT_NS, &deadline);
+	deadline += mach_absolute_time();
+	while (sdhci_rd32(REG_PRESENT_STATE) & 0x3u) {
+		if (mach_absolute_time() > deadline) {
+			printf("SARGO SDHCI: CMD%u: command/data line busy (pres 0x%08x)\n",
+			    idx, sdhci_rd32(REG_PRESENT_STATE));
+			sdhci_reset_cmd_data();
+			return EBUSY;
+		}
+		delay(10);
+	}
+
+	sdhci_set_reset(0x04);
+	nanoseconds_to_absolutetime(100000000ULL, &deadline);
+	deadline += mach_absolute_time();
+	while (sdhci_get_reset() & 0x04) {
+		if (mach_absolute_time() > deadline) {
+			break;
+		}
+		delay(10);
+	}
+	sdhci_set_reset(0x00);
+	sdhci_wr32(REG_BLOCK_SIZE, (n << 16) | SDHCI_BLOCK);
+	sdhci_set_host_pwr(sargo_hostctl, 0x0f);
+
+	for (uint32_t i = 0; i < nd; i++) {
+		uint32_t len = MIN(SARGO_MB_CHUNK, bytes - i * SARGO_MB_CHUNK);
+		uint64_t p = (uint64_t)kvtophys((vm_offset_t)(sargo_mb_buf + i * SARGO_MB_CHUNK));
+		sargo_mb_desc[i].cmd = (i == nd - 1) ? 0x0023u : 0x0021u;      /* TRAN|VALID (+END) */
+		sargo_mb_desc[i].len = (uint16_t)len;
+		sargo_mb_desc[i].addr_lo = (uint32_t)(p & 0xffffffffu);
+		sargo_mb_desc[i].addr_hi = (uint32_t)(p >> 32);
+	}
+	sargo_mb_desc[nd].cmd = 0x0003u;
+	sargo_mb_desc[nd].len = 0;
+	sargo_mb_desc[nd].addr_lo = 0;
+	sargo_mb_desc[nd].addr_hi = 0;
+	sargo_mb_flush(bytes);                  /* the CPU filled the buffer: clean it to RAM */
+	desc_phys = (uint64_t)kvtophys((vm_offset_t)sargo_mb_desc);
+	flush_dcache64(desc_phys, sizeof(sargo_mb_desc), TRUE);
+	sdhci_wr32(REG_ADMA_ADDR_LO, (uint32_t)(desc_phys & 0xffffffffu));
+	sdhci_wr32(REG_ADMA_ADDR_HI, (uint32_t)(desc_phys >> 32));
+
+	sdhci_wr32(REG_INT_STATUS, 0xffffffffu);
+	sdhci_wr32(REG_ARGUMENT, (uint32_t)lba);
+	/* Transfer Mode: DMA, block count enable, write; CMD25 adds Auto CMD12 and multi-block. */
+	sdhci_wr32(REG_TRANSFER_MODE,
+	    ((((uint32_t)idx << 8) | CMD_RESP_SHORT | CMD_FLAG_CRC | CMD_FLAG_INDEX | CMD_FLAG_DATA) << 16) |
+	    (n == 1 ? 0x0003u : 0x0027u));
+	__builtin_arm_dsb(0xf);
+
+	nanoseconds_to_absolutetime(CMD_TIMEOUT_NS, &deadline);
+	deadline += mach_absolute_time();
+	for (;;) {
+		uint32_t st = sdhci_rd32(REG_INT_STATUS);
+		nint = (uint16_t)(st & 0xffff);
+		eint = (uint16_t)(st >> 16);
+		if (nint & INT_CMD_COMPLETE) {
+			break;
+		}
+		if (eint || (nint & INT_ERROR)) {
+			error = (eint & EINT_CMD_TIMEOUT) ? ETIMEDOUT : EIO;
+			ss.data_fail = "write-cmd";
+			goto out;
+		}
+		if (mach_absolute_time() > deadline) {
+			error = ETIMEDOUT;
+			ss.data_fail = "write-cmd-timeout";
+			goto out;
+		}
+		delay(10);
+	}
+	if (sdhci_rd32(REG_RESPONSE0) & R1_ERROR_BITS) {
+		error = EIO;
+		ss.data_fail = "write-status";
+		goto out;
+	}
+	sdhci_wr32(REG_INT_STATUS, INT_CMD_COMPLETE);
+
+	/* Transfer Complete comes after the last block's busy (and Auto CMD12's). */
+	nanoseconds_to_absolutetime(SARGO_WR_BUSY_NS + (uint64_t)n * 20000000ull, &deadline);
+	deadline += mach_absolute_time();
+	for (;;) {
+		uint32_t st = sdhci_rd32(REG_INT_STATUS);
+		nint = (uint16_t)(st & 0xffff);
+		eint = (uint16_t)(st >> 16);
+		if (eint || (nint & INT_ERROR)) {
+			error = (eint & EINT_DATA_TIMEOUT) ? ETIMEDOUT : EIO;
+			ss.data_fail = "write-data";
+			goto out;
+		}
+		if (nint & INT_XFER_COMPLETE) {
+			break;
+		}
+		if (mach_absolute_time() > deadline) {
+			error = ETIMEDOUT;
+			ss.data_fail = "write-xfer-timeout";
+			goto out;
+		}
+		delay(10);
+	}
+	sdhci_wr32(REG_INT_STATUS, 0xffffffffu);
+	error = sargo_wait_programmed();
+	if (!error) {
+		sargo_wr_bytes += bytes;
+		return 0;
 	}
+	ss.data_fail = "write-programming";
+out:
+	ss.last_nint = nint;
+	ss.last_eint = eint;
+	if (error) {
+		uint32_t resp[4];
+		printf("SARGO SDHCI: CMD%u lba 0x%llx n %u failed (%s, nint 0x%04x eint 0x%04x adma_err 0x%08x)\n",
+		    idx, lba, n, ss.data_fail ? ss.data_fail : "?", nint, eint, sdhci_rd32(REG_ADMA_ERROR));
+		sdhci_reset_cmd_data();
+		sdhci_wr32(REG_INT_STATUS, 0xffffffffu);
+		if (idx == 25) {
+			/* Stop a multi-block write Auto CMD12 never ended (an error status here is fine). */
+			(void)sdhci_cmd(12, 0, CMD_RESP_SHORT_BUSY | CMD_FLAG_CRC | CMD_FLAG_INDEX, 0, resp);
+		}
+		(void)sargo_wait_programmed();
+	}
 	sdhci_wr32(REG_INT_STATUS, 0xffffffffu);
 	return error;
 }
